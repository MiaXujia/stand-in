# ============================================================
#  stand-in · 环境变量（复制为 .env）
#  所有路径都相对 STANDIN_ROOT；换机器/进容器只改这里
# ============================================================

# ---- 根目录（默认 = 仓库根目录，Docker 里是 /app）----
# STANDIN_ROOT=

# ---- 入口口令（≥32 位随机串；bootstrap 会自动生成）----
CHAT_TOKEN=

# ---- 你本人 ----
OWNER_NAME=
OWNER_PASSWORD=
# 可选：危机/叫停/日报推到哪儿（飞书/钉钉/自建 webhook），留空则只打印
OWNER_WEBHOOK=

# ---- 模型：改这三行就能换 DeepSeek / OpenAI / Qwen / Ollama / vLLM ----
# 第一次跑先用 fake 把流程跑通；填好 key 后改成任意名字
# （openai / deepseek / qwen / ollama / vllm 都行；只有 fake 是特例，表示不联网）
LLM_PROVIDER=fake
DEEPSEEK_API_KEY=
BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=400
LLM_TIMEOUT=30

# ---- 运行 ----
TZ=Asia/Shanghai
APP_NAME=stand-in
# 她看到的顶栏名字；留空则自动用 OWNER_NAME
DISPLAY_NAME=
# 启动日志里打印的入口前缀；换端口/域名时改这里
PUBLIC_URL=http://127.0.0.1:8000
# 本机直连（127.0.0.1、未经反代）时自动登录；公网/局域网仍然要 token 链接
LOCAL_AUTO_LOGIN=true
DISCLOSURE=honest
# honest = 普通对话中如实回答｜always = 每轮都声明；不单独拦截身份问题
LOG_LEVEL=INFO

# ---- 只有在用 deploy/docker-compose.yml 的 tls profile 时才需要 ----
# DOMAIN=chat.example.com

# ---- 前后端分离部署时才需要：允许的前端源（逗号分隔）----
# CORS_ORIGINS=https://example.com

# ---- 目录覆盖（默认都在 STANDIN_ROOT 下）----
# DATA_DIR=data
# PERSONA_DIR=persona
# MEMORY_DIR=memory
# CONFIG_DIR=config
# WEB_DIST=web/dist
